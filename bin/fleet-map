#!/bin/sh
# Regenerates maps/projects.md ONLY - the volatile ~/ project inventory.
# maps/fleet.md and maps/conventions.md are hand-written and untouched by
# this script. Run it, then `fleet respawn haiku-fs` to pick up the fresh
# baseline (its prefix is frozen; a changed baseline file needs a respawn).
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
OUT="$ROOT/maps/projects.md"

{
  echo "# Map of /Users/pup (generated by bin/fleet-map)"
  echo
  echo "generated: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo
  echo "## Top-level projects (dirs with a git repo or README)"
  for d in /Users/pup/*/; do
    n=$(basename "$d")
    if [ -d "$d/.git" ] || [ -f "$d/README.md" ]; then
      echo "- \`$n/\` — $(head -1 "$d/README.md" 2>/dev/null | sed 's/^# *//' | cut -c1-90)"
    fi
  done
} > "$OUT"
